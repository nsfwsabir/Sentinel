# Sentinel dashboard — standalone Next.js image (needs apps/dashboard/.next/standalone).
FROM node:22-slim AS build
RUN npm install -g pnpm@9
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps apps
COPY packages packages
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
RUN pnpm --filter @sentinel/dashboard build

FROM node:22-slim
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /repo/apps/dashboard/.next/standalone ./
COPY --from=build /repo/apps/dashboard/.next/static ./apps/dashboard/.next/static
EXPOSE 3000
CMD ["node", "apps/dashboard/server.js"]
