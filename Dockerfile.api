# Sentinel API — production image (managed PG/Redis via env).
# Dashboard deploys on any Node platform: `pnpm --filter @sentinel/dashboard build/start`.
FROM node:22-slim AS build
RUN npm install -g pnpm@9
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps apps
COPY packages packages
COPY tests tests
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY . .
RUN pnpm -r build
RUN pnpm --filter @sentinel/api --prod deploy /app

FROM node:22-slim
ENV NODE_ENV=production PORT=3001
WORKDIR /app
COPY --from=build /app ./
EXPOSE 3001
CMD ["node", "dist/index.js"]
