{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime policy enforcement for AI agents",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @sentinel/api dev",
    "dev:dashboard": "pnpm --filter @sentinel/dashboard dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
