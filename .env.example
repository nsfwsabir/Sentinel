# Copy to .env and fill in. Anything commented is optional (shown with defaults).

# Infra
DATABASE_URL=postgresql://user:pass@host:5432/sentinel
REDIS_URL=redis://localhost:6379

# Judgment provider: mock | laya | openai | ms-decision | jev (default mock).
# Unknown names refuse to boot. Sentinel never hosts models.
JUDGMENT_PROVIDER=mock
# LAYA_API_KEY=lsk_live_...            # Laya Studio; or self-host via LAYA_API_URL
# LAYA_API_URL=https://api.laya.studio/v1/systemone
# LAYA_MODE=hosted                     # or custom (default: hosted unless LAYA_API_URL set)
# LAYA_MODEL=                          # omit = auto-route
# OPENAI_API_KEY=sk-... OPENAI_MODEL=  # OpenAI Decisions (both required)
# OPENAI_API_URL=https://api.openai.com/v1/decisions
# MS_DECISION_API_KEY=sk-or-...        # Decision-1 via OpenRouter (model defaults set)
# MS_DECISION_MODEL=microsoft/microsoft-decision-1
# JEV_API_URL= JEV_API_KEY= JEV_MODEL= # any System-One-wire endpoint (key required if remote)
# *_TIMEOUT_MS=8000                    # per-provider prefix, e.g. LAYA_TIMEOUT_MS

# Policy engine: OPA WASM first, TypeScript fallback. Rebuild bundle with
# `pnpm --filter @sentinel/policy-opa bundle` (needs OPA CLI v1.x).
# OPA_BUNDLE_PATH=/custom/path/policy.wasm

# API
PORT=3001
AGENT_API_KEYS=dev-key-1,dev-key-2     # dev-only: production boot refuses these
# OIDC_ISSUERS=https://issuer.example.com   # BYO issuer; tokens bind `sub` to agentId
# OIDC_AUDIENCE=sentinel
# Runtime API keys live behind POST /v1/api-keys (plaintext returned once, hashes stored).
DECISION_HIGH_CONFIDENCE=0.90
DECISION_REVIEW_BELOW=0.80

# Dashboard auth. Dev default below; production needs ADMIN_PASS_HASH:
# pnpm --filter @sentinel/api build && node --input-type=module -e \
#   "import('./apps/api/dist/auth.js').then(m => m.hashAdminPassword('...').then(console.log))"
ADMIN_USER=admin
# ADMIN_PASS=changeme
# ADMIN_PASS_HASH=scrypt$<salt>$<hash>

# Dashboard SSO (BYO OIDC). Unset = dev mode, no login.
# AUTH_SECRET=generate-with-openssl-rand-hex-32
# AUTH_OIDC_ISSUER=https://issuer.example.com
# AUTH_OIDC_CLIENT_ID=sentinel-dashboard
# AUTH_OIDC_CLIENT_SECRET=...
