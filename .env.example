# Managed infra (Neon / Upstash)
DATABASE_URL=postgresql://user:pass@host:5432/sentinel
REDIS_URL=redis://localhost:6379

# Contextual judgment provider — mock by default, no key needed.
# Laya hosted (official API + your key) or self-hosted `laya-serve`
# (same System-One shape). Sentinel never hosts Laya.
JUDGMENT_PROVIDER=mock
# LAYA_MODE=hosted            # hosted | custom (default: hosted unless LAYA_API_URL set)
# LAYA_API_URL=https://api.laya.studio/v1/systemone
# LAYA_API_KEY=lsk_live_...
# LAYA_MODEL=                # english | multilingual | typed-decisions (omit = auto-route)
# LAYA_TIMEOUT_MS=8000

# API
PORT=3001
AGENT_API_KEYS=dev-key-1,dev-key-2
DECISION_HIGH_CONFIDENCE=0.90
DECISION_REVIEW_BELOW=0.80

# Dashboard basic auth (ADMIN_PASS plaintext is dev-only)
ADMIN_USER=admin
# ADMIN_PASS=changeme
# Production: set ADMIN_PASS_HASH instead of ADMIN_PASS. Generate with:
#   pnpm --filter @sentinel/api build && node --input-type=module -e \
#     "import { hashAdminPassword } from './apps/api/dist/auth.js'; console.log(await hashAdminPassword('your-password'))"
# ADMIN_PASS_HASH=scrypt$<salt>$<hash>
